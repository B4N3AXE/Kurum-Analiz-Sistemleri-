# GROQ_API_KEY: Required for Groq AI SDK API calls.
GROQ_API_KEY="MY_GROQ_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PAYTR INTEGRATION SETTINGS
# PayTR Mağaza Numarası (Merchant ID)
PAYTR_MERCHANT_ID=
# PayTR Mağaza API Anahtarı (Merchant Key)
PAYTR_MERCHANT_KEY=
# PayTR Mağaza API Salt Değeri (Merchant Salt)
PAYTR_MERCHANT_SALT=
# 1 for test sandbox, 0 for real production environment
PAYTR_TEST_MODE=0

# SMTP E-POSTA SUNUCU AYARLARI (ŞİFRE SIFIRLAMA MAİLLERİ İÇİN)
# MailerSend SMTP Bilgileri:
# Host: smtp.mailersend.net
# Port: 587
EMAIL_HOST=smtp.mailersend.net
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL="info@kurumanaliz.com"

# Alternatif SMTP Değişkenleri (Geriye Dönük Uyumluluk için)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
